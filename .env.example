# Hetzner Cloud API token (Read permission is enough).
# See README.md -> "How to get a Hetzner API Token".
API_TOKEN=

# Telegram notifications (optional).
# Leave both empty to disable Telegram and use console output only.
# See README.md -> "How to create a Telegram Bot" and "How to get the Chat ID".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional overrides (sensible defaults are used if omitted) ---

# Server type(s) to watch. Comma-separated list of Hetzner "names".
# Examples: cx33  |  cx33,cx23  |  cx33,cpx31,cax21
SERVER_TYPES=cx33

# Comma-separated list of Hetzner location names to check.
LOCATIONS=fsn1,nbg1,hel1

# Interval between checks, in seconds (ignored when RUN_ONCE=true).
CHECK_INTERVAL_SECONDS=60

# Run a single check and exit, instead of looping forever.
# Set to true for one-shot / cron-style runners.
RUN_ONCE=false

# In loop mode, stop cleanly after this many seconds (0 = run forever).
# Used on GitHub Actions to exit before the 6h job limit. Leave 0 locally.
MAX_RUNTIME_SECONDS=0

# Optional file to persist "already notified" state across separate runs.
# Used with RUN_ONCE or run handoffs so Telegram still notifies only once.
# Also stores "already provisioned" flags (provisioned:<type>).
STATE_FILE=

# --- Auto-provisioning (optional, disabled by default) ---
# When true, the monitor creates ONE server per watched type the first time
# it becomes available (first available location in LOCATIONS order wins),
# then keeps monitoring the remaining types. Billing starts immediately.
# Requires a Read & Write API token (monitoring alone works with Read-only).

# Master switch. Leave false for notify-only mode.
PROVISION_ENABLED=false

# OS image for created servers, e.g. ubuntu-24.04, debian-12.
# Required when PROVISION_ENABLED=true.
PROVISION_IMAGE=

# Comma-separated SSH key names already uploaded to Hetzner Cloud.
# Empty is allowed but not recommended (you may lock yourself out).
PROVISION_SSH_KEYS=

# Prefix for auto-created server names. Final name is "<prefix><type>",
# e.g. prefix "hetzcheck-" + type "cx33" -> "hetzcheck-cx33".
# The name doubles as the idempotency key (remote existence check).
PROVISION_NAME_PREFIX=hetzcheck-

# When true, log what would be created without calling POST /servers.
# Use this to test safely before enabling real provisioning.
PROVISION_DRY_RUN=false
